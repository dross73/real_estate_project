# Local development example.
# Copy this file to .env at the project root and replace secrets before use.

# Option 1: provide one complete SQLAlchemy URL.
DATABASE_URL=postgresql+psycopg2://admin_db:admin_db@localhost:5432/realestate

# Option 2: instead of DATABASE_URL, provide all individual Postgres values.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=realestate
# POSTGRES_USER=admin_db
# POSTGRES_PASSWORD=admin_db

# JWT settings.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_ISSUER=real-estate-api
JWT_AUDIENCE=real-estate-frontend

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Runtime label: dev, test, staging, or production.
ENV=dev

# Public frontend URL used in account-verification email links.
PUBLIC_APP_URL=http://localhost:4200

# Email delivery. "log" safely suppresses delivery; "smtp" sends email.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_ADDRESS=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=10

# Email verification policy.
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EXPIRE_MINUTES=60

# Media storage.
# Local development writes uploads under backend/uploads and FastAPI serves them.
MEDIA_STORAGE_BACKEND=local
LOCAL_MEDIA_ROOT=backend/uploads
LOCAL_MEDIA_BASE_URL=http://localhost:8000/media

# Production uses an S3-compatible provider. Keep these blank locally unless
# you intentionally want to test S3-compatible storage.
# OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ENDPOINT_URL=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_ADDRESSING_STYLE=auto
OBJECT_STORAGE_PRESIGNED_URL_EXPIRE_SECONDS=900

# Never commit real production object-storage credentials.

# Listing-photo processing safety/optimization defaults.
IMAGE_UPLOAD_MAX_BYTES=78643200
IMAGE_UPLOAD_MAX_PIXELS=100000000
LISTING_PHOTO_MAX_COUNT=50
DOCUMENT_UPLOAD_MAX_BYTES=20971520
IMAGE_THUMBNAIL_MAX_EDGE=480
IMAGE_MEDIUM_MAX_EDGE=960
IMAGE_LARGE_MAX_EDGE=1800
IMAGE_WEBP_QUALITY=84


# Production deployment notes (Render + external S3-compatible storage):
# ENV=production
# MEDIA_STORAGE_BACKEND=s3
# PUBLIC_APP_URL=https://realestate.dan-ross.dev
# CORS_ORIGINS=https://realestate.dan-ross.dev
# Use a generated SECRET_KEY with at least 32 characters.
# Production requires SMTP delivery and configured object-storage credentials.
# Never commit production values to this file or to source control.
