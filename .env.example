# Local development example.
# Copy this file to .env at the project root and replace secrets before use.

# Option 1: provide one complete SQLAlchemy URL.
DATABASE_URL=postgresql+psycopg2://admin_db:admin_db@localhost:5432/realestate

# Option 2: instead of DATABASE_URL, provide all individual Postgres values.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=realestate
# POSTGRES_USER=admin_db
# POSTGRES_PASSWORD=admin_db

# JWT settings.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_ISSUER=real-estate-api
JWT_AUDIENCE=real-estate-frontend

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Runtime label: dev, test, staging, or production.
ENV=dev

# Public frontend URL used in account-verification email links.
PUBLIC_APP_URL=http://localhost:4200

# Email delivery. "log" prints local-development messages; "smtp" sends email.
EMAIL_DELIVERY_MODE=log
EMAIL_FROM_ADDRESS=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_TIMEOUT_SECONDS=10

# Email verification policy.
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
